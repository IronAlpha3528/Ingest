# ==============================================================================
# Ingest Configuration Template (.env.example)
# Copy this file to .env and supply the required credentials.
# ==============================================================================

# [REQUIRED] Sarvam AI API subscription key
# Covers: LLM (Sarvam-105B), OCR (Sarvam Vision), Language ID, and Translation
SARVAM_API_KEY=sk_your_sarvam_api_key_here

# [REQUIRED] Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# [REQUIRED] Web search provider API key (Tavily or Brave) for project research briefs
SEARCH_API_KEY=tvly-your_search_api_key_here

# [REQUIRED] Absolute filesystem path to the root of your local Obsidian vault
VAULT_PATH=D:\ObsidianVault

# [OPTIONAL] LLM model for classification and project expansion (default: sarvam-105b)
MODEL=sarvam-105b

# [OPTIONAL] Translation model (default: sarvam-translate:v1; alternative: mayura:v1)
TRANSLATE_MODEL=sarvam-translate:v1

# [OPTIONAL] Document intelligence OCR model (default: sarvam-vision)
OCR_MODEL=sarvam-vision

# [OPTIONAL] Maximum attachment download size in megabytes (default: 20)
MAX_DOWNLOAD_MB=20

# [OPTIONAL] Maximum characters per translation chunk at sentence boundaries (default: 2000)
TRANSLATE_CHUNK_CHARS=2000
